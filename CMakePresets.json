{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolset": "host=x64",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "TIMETRANSLE_FETCH_DEPENDENCIES": "ON"
      },
      "environment": {
        "VSLANG": "1033"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Configure the x64 Controller, Injector, Hook and TestApp build tree.",
      "inherits": "windows-base",
      "architecture": "x64"
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86",
      "description": "Configure the Win32 Injector, Hook and TestApp build tree.",
      "inherits": "windows-base",
      "architecture": "Win32"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-x64-debug",
      "steps": [
        {
          "type": "configure",
          "name": "windows-x64"
        },
        {
          "type": "build",
          "name": "windows-x64-debug"
        },
        {
          "type": "test",
          "name": "windows-x64-debug"
        }
      ]
    },
    {
      "name": "windows-x86-debug",
      "steps": [
        {
          "type": "configure",
          "name": "windows-x86"
        },
        {
          "type": "build",
          "name": "windows-x86-debug"
        },
        {
          "type": "test",
          "name": "windows-x86-debug"
        }
      ]
    }
  ]
}
